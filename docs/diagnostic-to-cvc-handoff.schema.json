{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anil-ganti-nbc/cvc-clank/blob/main/docs/diagnostic-to-cvc-handoff.schema.json",
  "title": "Diagnostic to CVC handoff",
  "description": "Evidence package that a Diagnostic Clank may offer for explicit operator ingestion into CVC. The package is not an automatic ingest instruction.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_clank",
    "incident_id",
    "incident_date",
    "historical_verdict",
    "report_artifact_reference",
    "affected_components",
    "root_cause",
    "first_failed_gate",
    "remediation_evidence",
    "candidate_lesson",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "diagnostic-to-cvc-handoff.v0.1"
    },
    "source_clank": {
      "type": "string",
      "minLength": 1
    },
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "incident_date": {
      "type": "string",
      "format": "date"
    },
    "historical_verdict": {
      "type": "string",
      "minLength": 1
    },
    "report_artifact_reference": {
      "type": "string",
      "minLength": 1
    },
    "affected_components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "root_cause": {
      "type": "string",
      "minLength": 1
    },
    "first_failed_gate": {
      "type": "string",
      "minLength": 1
    },
    "remediation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "references"],
      "properties": {
        "available": {
          "type": "boolean"
        },
        "references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "candidate_lesson": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_sha256"],
      "properties": {
        "source_repository": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "captured_at_utc": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
